APP_ENV=development
# OPENAI_API_KEY=
# Leave both values empty to use process-local storage in development.
# PostgreSQL example: postgresql+psycopg://finshield:change-me@localhost:5432/finshield
# Local encrypted prototype: sqlite+pysqlite:///./finshield.sqlite3
# DATABASE_URL=
# Comma-separated Fernet keys. The first key encrypts new writes; older keys decrypt
# existing rows during key rotation. Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PROFILE_ENCRYPTION_KEYS=
# Anonymous session lifetime. Default 30 days; allowed range 300..31536000.
# AUTH_SESSION_TTL_SECONDS=2592000
# Paste the public-data portal general key as issued. Never commit a real key.
# PUBLIC_DATA_SERVICE_KEY=
