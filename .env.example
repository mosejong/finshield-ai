APP_ENV=development
# LLM explanation layer. Empty (the default) turns it off: the analyze endpoint is
# unaffected and /api/v1/analyze/explanation answers 200 with available=false.
# Accepted values: off, stub, google_ai_studio. A typo is refused at startup rather
# than silently treated as off. The models are pinned in code, not here - see
# docs/34-llm-explanation-runtime.md for why.
# FINSHIELD_LLM_PROVIDER=
# Google AI Studio (Gemini API) key. Required only when the provider above is
# google_ai_studio; the service refuses to start if it is missing. Never commit a
# real key. compose.gemini.yaml mounts the file form.
# GEMINI_API_KEY=
# GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
# Leave both values empty to use process-local storage in development.
# PostgreSQL example: postgresql+psycopg://finshield:change-me@localhost:5432/finshield
# Local encrypted prototype: sqlite+pysqlite:///./finshield.sqlite3
# DATABASE_URL=
# Docker/secret-manager alternative: configure components and mount the password.
# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=finshield
# DATABASE_USER=finshield_app
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
# Comma-separated Fernet keys. The first key encrypts new writes; older keys decrypt
# existing rows during key rotation. Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PROFILE_ENCRYPTION_KEYS=
# PROFILE_ENCRYPTION_KEYS_FILE=/run/secrets/profile_encryption_keys
# Anonymous session lifetime. Default 30 days; allowed range 300..31536000.
# AUTH_SESSION_TTL_SECONDS=2592000
# Paste the public-data portal general key as issued. Never commit a real key.
# PUBLIC_DATA_SERVICE_KEY=
# PUBLIC_DATA_SERVICE_KEY_FILE=/run/secrets/public_data_service_key
# How many right-hand X-Forwarded-For entries are written by proxies you run.
# 0 (default) trusts no forwarded header and identifies clients by TCP peer.
# Deployed environments must set this explicitly; behind the bundled Caddy the
# value is 1. Setting it too high lets a client forge its own address.
# FINSHIELD_TRUSTED_PROXY_HOPS=0
# Request rate limiting. Off by default in development and test, on otherwise.
# FINSHIELD_RATE_LIMIT_ENABLED=
# HMAC key for rate limit bucket keys, so stored counters are not an access log.
# Required when deployed; at least 32 characters and shared by every worker.
# FINSHIELD_RATE_LIMIT_SECRET=
# FINSHIELD_RATE_LIMIT_SECRET_FILE=/run/secrets/rate_limit_secret
# Maximum request body accepted before parsing. Default 131072; range 4096..10485760.
# The web tier reads the same variable and enforces the same limit on its proxy
# routes, so raise both together or not at all.
# FINSHIELD_MAX_REQUEST_BYTES=131072
# How often the retention container deletes expired anonymous data and closed
# rate limit windows. Default 3600; range 60..86400. The container reports
# unhealthy when no cleanup has succeeded for two intervals.
# FINSHIELD_RETENTION_INTERVAL_SECONDS=3600
# Where the retention container records its last successful run. Defaults to the
# system temp directory, which is the only writable path in the read-only image.
# FINSHIELD_RETENTION_HEARTBEAT_PATH=
