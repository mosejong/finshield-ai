# Local Compose only. Public deployment must use APP_ENV=production behind HTTPS.
APP_ENV=development
POSTGRES_DB=finshield
POSTGRES_USER=finshield_app
BACKEND_PORT=18000
WEB_PORT=13000
AUTH_SESSION_TTL_SECONDS=2592000
# No proxy in front of web:3000 in this file, so no forwarded hop is trusted.
# compose.https.yaml raises this to 1 for the Caddy -> web -> backend path.
FINSHIELD_TRUSTED_PROXY_HOPS=0
# Rate limiting follows APP_ENV: off for development, on for production.
# Set to 1 to exercise 429 responses against this local stack.
# FINSHIELD_RATE_LIMIT_ENABLED=1
# The HMAC key comes from secrets/rate_limit_secret.txt.
# Create it with: python -m scripts.create_local_docker_secrets
# Official public-data key is intentionally not passed to this local persistence stack.
