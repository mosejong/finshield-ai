# Local Compose only. Public deployment must use APP_ENV=production behind HTTPS.
APP_ENV=development
POSTGRES_DB=finshield
POSTGRES_USER=finshield_app
BACKEND_PORT=18000
WEB_PORT=13000
AUTH_SESSION_TTL_SECONDS=2592000
# uvicorn worker processes for the backend container. Two is the default and
# suits a normal machine. Set it to 1 on a small host (1GB / shared vCPU): the
# second worker costs memory that box does not have and buys no throughput
# there. On 2026-08-18 two workers on a GCP e2-micro wedged the backend
# permanently with no traceback. The Dockerfile CMD raises uvicorn's worker
# healthcheck timeout so that particular failure cannot recur, but one worker
# is still the right size for that host. See docs/31-public-deployment.md 11-6.
# FINSHIELD_UVICORN_WORKERS=2
# No proxy in front of web:3000 in this file, so no forwarded hop is trusted.
# compose.https.yaml raises this to 1 for the Caddy -> web -> backend path.
FINSHIELD_TRUSTED_PROXY_HOPS=0
# Rate limiting follows APP_ENV: off for development, on for production.
# Set to 1 to exercise 429 responses against this local stack.
# FINSHIELD_RATE_LIMIT_ENABLED=1
# The HMAC key comes from secrets/rate_limit_secret.txt.
# Create it with: python -m scripts.create_local_docker_secrets
# Expired data cleanup runs hourly by default. Lower it to watch a real deletion
# without waiting an hour; the runtime verification script requires a short value.
# FINSHIELD_RETENTION_INTERVAL_SECONDS=60
# Official public-data key is intentionally not passed to this local persistence stack.
#
# --- Public deployment (compose.https.yaml). See docs/31-public-deployment.md. ---
# Both are required by compose.https.yaml; it refuses to start without them.
# The apex name only. Caddy requests the certificate for exactly this name.
# FINSHIELD_DOMAIN=finshield.example.com
# ACME account contact. Renewal fails silently, and this mailbox is the only
# channel the issuer can warn you through. Use one a human actually reads.
# FINSHIELD_ACME_EMAIL=ops@finshield.example.com
#
# Local HTTPS rehearsal without burning any ACME quota: Caddy issues localhost
# from its own internal CA.
#   FINSHIELD_DOMAIN=localhost FINSHIELD_ACME_EMAIL=ops@example.com \
#     docker compose -f compose.yaml -f compose.https.yaml up -d proxy
#   python -m scripts.verify_public_deployment --domain localhost --insecure
